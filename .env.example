# Supabase project settings (Project Settings → API). Required: the app only works signed in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only (used by /api in `npm run dev`). NEVER prefix with VITE_ or NEXT_PUBLIC_.
# In production it lives in Vercel → Settings → Environment Variables (Sensitive). See docs/openai-setup.md
OPENAI_API_KEY=
